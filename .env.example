# Cascata de IA (PJ-34): BYOK → cota grátis → Ollama
# 1) BYOK: chave + modelo SEM :free  →  2) cota :free  →  3) Ollama local
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Exemplo BYOK (pago): OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Opcional — Ollama (fallback local; padrão http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Stub de cotas (contadores em memória; enforcement off por padrão)
# ELIO_AI_BUDGET_BYOK_DAILY=
# ELIO_AI_BUDGET_FREE_DAILY=
# ELIO_AI_BUDGET_LOCAL_DAILY=
# ELIO_AI_BUDGET_ENFORCE=false

# Opcional — STT (padrão: Windows Speech no Windows; Whisper = fallback)
# ELIO_STT_PROVIDER=auto
# ELIO_STT_PROVIDER=windows-speech
# ELIO_STT_PROVIDER=whisper
# ELIO_WHISPER_MODEL=small

# Opcional — Spotify (PKCE; sem client secret)
# Crie um app em https://developer.spotify.com/dashboard
# Redirect URI exata: http://127.0.0.1:47821/callback
# ELIO_SPOTIFY_CLIENT_ID=...

# Opcional — distribuição / update (só machine local; nunca no git)
# ELIO_DISABLE_UPDATER=1
# GH_TOKEN=ghp_...          # só para npm run release:win
# CSC_LINK=C:\certs\elio.pfx
# CSC_KEY_PASSWORD=...
